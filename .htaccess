# Escolapedia: la web publicada es la carpeta dist/ (generada con build.js).
DirectoryIndex index.html
ErrorDocument 404 /dist/404.html
RewriteEngine On

# www → sin www
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

# Si alguien pide /dist/... directamente, se le manda a la URL limpia (evita contenido duplicado).
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/dist/
RewriteRule ^dist/(.*)$ /$1 [R=301,L,NE]

# Carpeta sin barra final → con barra
RewriteCond %{DOCUMENT_ROOT}/dist/$1 -d
RewriteRule ^(.*[^/])$ /$1/ [R=301,L]

# Todo lo demás se sirve desde dist/
RewriteCond %{REQUEST_URI} !^/dist/
RewriteRule ^(.*)$ dist/$1 [L]

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  # Las páginas se comprueban siempre con el servidor, para que los cambios se vean sin borrar la caché.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
</IfModule>
